# =============================================================================
# Luminary E-Commerce — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ── Database (Supabase PostgreSQL / Cloud PostgreSQL) ─────────────────────────
# When using Supabase on Render, use the Connection Pooler (port 6543) for IPv4 support:
# Format: jdbc:postgresql://aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or standard URI: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Min 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── CORS / Allowed Frontend URLs ──────────────────────────────────────────────
# Comma-separated list of origins. (Note: *.vercel.app and localhost are auto-allowed)
FRONTEND_URL=https://your-app.vercel.app

# ── Groq AI (Optional for AI Shopping Assistant) ──────────────────────────────
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_MS=15000
GROQ_MAX_RETRIES=2

# ── Frontend (Vercel — configure in Vercel project environment variables) ──────
VITE_API_BASE_URL=https://your-backend.onrender.com
