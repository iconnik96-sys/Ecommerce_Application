# =============================================================================
# Luminary E-Commerce — Environment Variables
# Copy this file to .env and fill in your values.
# =============================================================================

# ── Database (PostgreSQL / Supabase) ──────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Min 32 characters. Generate one: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── CORS / Frontend URL ──────────────────────────────────────────────────────
FRONTEND_URL_TEST=http://localhost:5173,http://localhost:3000

# ── Groq AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TIMEOUT_MS=15000
GROQ_MAX_RETRIES=2

# ── Frontend (Vite — prefix with VITE_) ──────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080
